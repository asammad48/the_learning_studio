{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/asammad48/the_learning_studio",
        "ref": "main",
        "path": "wordpress-theme/the-learning-studio"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; tls_import_json_content( get_stylesheet_directory() . '/legacy-data', false, false ); tls_run_site_setup( true, true, true );"
    }
  ]
}
